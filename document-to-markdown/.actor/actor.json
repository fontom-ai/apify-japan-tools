{
  "actorSpecification": 1,
  "name": "document-to-markdown",
  "title": "Document to Markdown & RAG Chunks (PDF, Word, Excel, CJK)",
  "description": "Turn PDF, DOCX, XLSX, PPTX, HTML and CSV files into clean Markdown, plain text and RAG-ready chunks. Two-column PDFs, Japanese/Chinese/Korean text and tables handled. No OCR, no AI guessing, no third-party API.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "ok",
              "source",
              "type",
              "title",
              "pages",
              "script",
              "chars",
              "markdown",
              "chunks",
              "warnings",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "ok": {
                "label": "OK"
              },
              "source": {
                "label": "Source"
              },
              "type": {
                "label": "Type"
              },
              "pages": {
                "label": "Pages"
              },
              "script": {
                "label": "Script"
              },
              "chars": {
                "label": "Characters"
              },
              "warnings": {
                "label": "Warnings"
              },
              "error": {
                "label": "Error"
              }
            }
          }
        }
      }
    }
  }
}
